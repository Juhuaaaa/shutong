{
  "name": "shutong-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "test": "vitest run",
    "lint": "eslint . && vue-tsc --noEmit",
    "gen:api": "uv run --project ../backend python -m shutong.api.export > src/api/openapi.json && openapi-typescript src/api/openapi.json -o src/api/schema.d.ts",
    "check-api": "pnpm gen:api && git diff --exit-code -- src/api/openapi.json src/api/schema.d.ts",
    "e2e": "pnpm build && playwright test"
  },
  "dependencies": {
    "@mdi/js": "^7.4.47",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.16",
    "vue-router": "^5.4.0",
    "vuetify": "^4.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "openapi-typescript": "^7.13.0",
    "sass": "^1.107.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^5.0.5",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.13"
  }
}
